{
  "$id": "https://realmz-castle.github.io/schemas/semantic-replay-child-result-v3.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Result emitted by one external semantic replay child; it is not an equivalence verdict.",
  "properties": {
    "child_nonce": {
      "pattern": "^[0-9a-f]{32}(?![\\s\\S])",
      "type": "string"
    },
    "engine_identity": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "presentation_mode": {
      "enum": [
        "classic",
        "remastered"
      ]
    },
    "replay_route": {
      "enum": [
        "classic",
        "semantic"
      ]
    },
    "process_id": {
      "minimum": 1,
      "type": "integer"
    },
    "rng_draw_count": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "type": "integer"
    },
    "rng_seed": {
      "pattern": "^[0-9a-f]{16}(?![\\s\\S])",
      "type": "string"
    },
    "rng_stream": {
      "pattern": "^[0-9a-f]{16}(?![\\s\\S])",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[0-9a-f]{32}(?![\\s\\S])",
      "type": "string"
    },
    "save_tree_sha256": {
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
      "type": "string"
    },
    "schema_version": {
      "const": 3
    },
    "settled_action_count": {
      "maximum": 4096,
      "minimum": 0,
      "type": "integer"
    },
    "state_sha256": {
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
      "type": "string"
    },
    "status": {
      "const": "completed"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "child_nonce",
    "replay_route",
    "presentation_mode",
    "process_id",
    "status",
    "engine_identity",
    "settled_action_count",
    "state_sha256",
    "save_tree_sha256",
    "rng_draw_count",
    "rng_seed",
    "rng_stream"
  ],
  "title": "Realmz semantic replay child result v3",
  "type": "object"
}
