{
  "$id": "https://realmz-castle.github.io/schemas/semantic-replay-run-envelope-v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Process-isolation output only. It deliberately carries no engine-equivalence verdict.",
  "properties": {
    "child_results": {
      "items": {
        "$ref": "https://realmz-castle.github.io/schemas/semantic-replay-child-result-v2.json"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "executable": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "run_id": {
      "pattern": "^[0-9a-f]{32}(?![\\s\\S])",
      "type": "string"
    },
    "runner_scope": {
      "const": "process_isolation_only"
    },
    "rng_seed": {
      "pattern": "^[0-9a-f]{16}(?![\\s\\S])",
      "type": "string"
    },
    "rng_stream": {
      "pattern": "^[0-9a-f]{16}(?![\\s\\S])",
      "type": "string"
    },
    "schema_version": {
      "const": 2
    },
    "semantic_equivalence": {
      "const": "not_evaluated"
    },
    "workspace_retention": {
      "additionalProperties": false,
      "properties": {
        "candidate_path": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "cleanup_attempted": {
          "const": false
        },
        "notice": {
          "minLength": 1,
          "type": "string"
        },
        "path_authoritative": {
          "type": "boolean"
        }
      },
      "required": [
        "cleanup_attempted",
        "candidate_path",
        "path_authoritative",
        "notice"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "runner_scope",
    "semantic_equivalence",
    "executable",
    "child_results",
    "rng_seed",
    "rng_stream",
    "workspace_retention"
  ],
  "title": "Realmz semantic replay run envelope v2",
  "type": "object"
}
