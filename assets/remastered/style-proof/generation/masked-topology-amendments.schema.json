{
  "$defs": {
    "alphaEvidence": {
      "additionalProperties": false,
      "properties": {
        "decoded_png_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "dimensions": {
          "additionalProperties": false,
          "properties": {
            "height": {
              "minimum": 1,
              "type": "integer"
            },
            "width": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "height",
            "width"
          ],
          "type": "object"
        },
        "enclosed_transparent_component_sizes_4_connected": {
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "type": "array"
        },
        "foreground_bbox": {
          "additionalProperties": false,
          "properties": {
            "bottom": {
              "minimum": 0,
              "type": "integer"
            },
            "left": {
              "minimum": 0,
              "type": "integer"
            },
            "right": {
              "minimum": 0,
              "type": "integer"
            },
            "top": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "bottom",
            "left",
            "right",
            "top"
          ],
          "type": "object"
        },
        "foreground_component_sizes_4_connected": {
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "minItems": 1,
          "type": "array"
        },
        "foreground_pixels": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "decoded_png_sha256",
        "dimensions",
        "enclosed_transparent_component_sizes_4_connected",
        "foreground_bbox",
        "foreground_component_sizes_4_connected",
        "foreground_pixels"
      ],
      "type": "object"
    },
    "entry": {
      "additionalProperties": false,
      "properties": {
        "amendment_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "classic_alpha_evidence": {
          "$ref": "#/$defs/alphaEvidence"
        },
        "job_id": {
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "type": "string"
        },
        "reviewer": {
          "const": "Codex Classic-alpha audit"
        },
        "text": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "amendment_sha256",
        "classic_alpha_evidence",
        "job_id",
        "reason",
        "recorded_at",
        "reviewer",
        "text"
      ],
      "type": "object"
    },
    "lockedSchema": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "const": "assets/remastered/style-proof/generation/masked-topology-amendments.schema.json"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
